# ================================================
# 本地私有配置（示例文件）
# 用法：复制为 config.local.yaml 后填写；该文件已被 .gitignore 忽略，绝不进库。
# 优先级：环境变量 > 本文件 > config.yaml 缺省
# ================================================

notify:
  # 企业微信「群机器人」webhook 地址
  # 获取方式：企业微信群 → 右上角设置 → 群机器人 → 添加机器人 → 复制地址
  wecom_webhook_url: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME"

live:
  # SimNow 仿真账号（v2.0，docs/16；注册地址 simnow.com.cn，仅工作日 9:00-15:00）
  investor_id: "REPLACE_ME"       # 投资者代码（6 位数字，即登录账号）
  password: "REPLACE_ME"          # 登录密码
  # 可选：临时切换环境（覆盖 config.yaml 的 live.env）
  # env: "724"
